				<TR><TD PORT="inode_number_pos">0</TD><TD PORT="inode_number_size">4</TD><TD>u4le</TD><TD PORT="inode_number_type">inode_number</TD></TR>
				<TR><TD PORT="padding_pos">4</TD><TD PORT="padding_size">12</TD><TD></TD><TD PORT="padding_type">padding</TD></TR>
				<TR><TD PORT="old_size_pos">16</TD><TD PORT="old_size_size">8</TD><TD>u8le</TD><TD PORT="old_size_type">old_size</TD></TR>
				<TR><TD COLSPAN="4" PORT="old_size__valid">must be at least 1</TD></TR>
				<TR><TD PORT="new_size_pos">24</TD><TD PORT="new_size_size">8</TD><TD>u8le</TD><TD PORT="new_size_type">new_size</TD></TR>
				<TR><TD COLSPAN="4" PORT="new_size__valid">must be at most old_size - 1</TD></TR>
			</TABLE>>];
		}
