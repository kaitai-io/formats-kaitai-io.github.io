				<TR><TD>len_hash</TD><TD>(!(authenticated) ? 0 : ( ((hash_algo == :hash_algos_md4) || (hash_algo == :hash_algos_md5) || (hash_algo == :hash_algos_ripe_md_128) || (hash_algo == :hash_algos_tgr_128))  ? 16 : ( ((hash_algo == :hash_algos_sha1) || (hash_algo == :hash_algos_ripe_md_160) || (hash_algo == :hash_algos_tgr_160))  ? 20 : (hash_algo == :hash_algos_tgr_192 ? 24 : (hash_algo == :hash_algos_sha224 ? 28 : ( ((hash_algo == :hash_algos_sha256) || (hash_algo == :hash_algos_ripe_md_256) || (hash_algo == :hash_algos_wp_256) || (hash_algo == :hash_algos_sm3_256) || (hash_algo == :hash_algos_streebog_256) || (hash_algo == :hash_algos_sha3_256))  ? 32 : (hash_algo == :hash_algos_ripe_md_320 ? 40 : ( ((hash_algo == :hash_algos_sha384) || (hash_algo == :hash_algos_wp_384) || (hash_algo == :hash_algos_sha3_384))  ? 48 : ( ((hash_algo == :hash_algos_sha512) || (hash_algo == :hash_algos_wp_512) || (hash_algo == :hash_algos_streebog_512) || (hash_algo == :hash_algos_sha3_512))  ? 64 : -1)))))))))</TD></TR>
			</TABLE>>];
			superblock_header__inst__space_fixup [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>space_fixup</TD><TD>flags &amp; 4 != 0</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__superblock_node {
			label="Ubifs::SuperblockNode";
			graph[style=dotted];

			superblock_node__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="header_pos">0</TD><TD PORT="header_size">24</TD><TD>CommonHeader</TD><TD PORT="header_type">header</TD></TR>
				<TR><TD COLSPAN="4" PORT="header__valid">must satisfy _.node_type == :node_types_superblock</TD></TR>
				<TR><TD PORT="node_header_pos">24</TD><TD PORT="node_header_size">header.len_full_node - 24</TD><TD>SuperblockHeader</TD><TD PORT="node_header_type">node_header</TD></TR>
			</TABLE>>];
		}
