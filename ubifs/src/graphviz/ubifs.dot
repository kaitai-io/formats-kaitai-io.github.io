digraph {
	rankdir=LR;
	node [shape=plaintext];
	subgraph cluster__ubifs {
		label="Ubifs";
		graph[style=dotted];

		ubifs__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
		</TABLE>>];
		ubifs__inst__index [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="index_pos">superblock.node_header.leb_size * master_1.node_header.leb_root</TD><TD PORT="index_size">superblock.node_header.leb_size</TD><TD>Dummy</TD><TD PORT="index_type">index</TD></TR>
		</TABLE>>];
		ubifs__inst__index_root [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="index_root_pos">master_1.node_header.ofs_root</TD><TD PORT="index_root_size">...</TD><TD>IndexBlock</TD><TD PORT="index_root_type">index_root</TD></TR>
			<TR><TD COLSPAN="4" PORT="index_root__valid">must satisfy _.header.len_full_node == master_1.node_header.len_root</TD></TR>
		</TABLE>>];
		ubifs__inst__lebs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="lebs_pos">0</TD><TD PORT="lebs_size">superblock.node_header.leb_size</TD><TD></TD><TD PORT="lebs_type">lebs</TD></TR>
			<TR><TD COLSPAN="4" PORT="lebs__repeat">repeat superblock.node_header.num_lebs times</TD></TR>
		</TABLE>>];
		ubifs__inst__len_image [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
			<TR><TD>len_image</TD><TD>superblock.node_header.leb_size * superblock.node_header.num_lebs</TD></TR>
		</TABLE>>];
		ubifs__inst__master_1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="master_1_pos">superblock.node_header.leb_size</TD><TD PORT="master_1_size">superblock.node_header.leb_size</TD><TD>MasterblockNode</TD><TD PORT="master_1_type">master_1</TD></TR>
		</TABLE>>];
		ubifs__inst__master_2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="master_2_pos">superblock.node_header.leb_size * 2</TD><TD PORT="master_2_size">superblock.node_header.leb_size</TD><TD>MasterblockNode</TD><TD PORT="master_2_type">master_2</TD></TR>
		</TABLE>>];
		ubifs__inst__superblock [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
			<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			<TR><TD PORT="superblock_pos">0</TD><TD PORT="superblock_size">...</TD><TD>SuperblockNode</TD><TD PORT="superblock_type">superblock</TD></TR>
		</TABLE>>];
		subgraph cluster__authentication_header {
			label="Ubifs::AuthenticationHeader";
			graph[style=dotted];

			authentication_header__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="hmac_pos">0</TD><TD PORT="hmac_size">_root.superblock.node_header.len_hash</TD><TD></TD><TD PORT="hmac_type">hmac</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__block {
			label="Ubifs::Block";
			graph[style=dotted];

			block__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="header_pos">0</TD><TD PORT="header_size">24</TD><TD>CommonHeader</TD><TD PORT="header_type">header</TD></TR>
				<TR><TD PORT="node_header_pos">24</TD><TD PORT="node_header_size">...</TD><TD>switch (header.node_type)</TD><TD PORT="node_header_type">node_header</TD></TR>
			</TABLE>>];
block__seq_node_header_switch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
	<TR><TD BGCOLOR="#F0F2E4">case</TD><TD BGCOLOR="#F0F2E4">type</TD></TR>
	<TR><TD>:node_types_authentication</TD><TD PORT="case0">AuthenticationHeader</TD></TR>
	<TR><TD>:node_types_commit_start</TD><TD PORT="case1">CommitStartHeader</TD></TR>
	<TR><TD>:node_types_data</TD><TD PORT="case2">DataHeader</TD></TR>
	<TR><TD>:node_types_directory</TD><TD PORT="case3">DirectoryHeader</TD></TR>
	<TR><TD>:node_types_extended_attribute</TD><TD PORT="case4">DirectoryHeader</TD></TR>
	<TR><TD>:node_types_index</TD><TD PORT="case5">IndexHeader</TD></TR>
	<TR><TD>:node_types_inode</TD><TD PORT="case6">InodeHeader</TD></TR>
	<TR><TD>:node_types_master</TD><TD PORT="case7">MasterHeader</TD></TR>
	<TR><TD>:node_types_orphan</TD><TD PORT="case8">OrphanHeader</TD></TR>
	<TR><TD>:node_types_padding</TD><TD PORT="case9">PaddingHeader</TD></TR>
	<TR><TD>:node_types_reference</TD><TD PORT="case10">ReferenceHeader</TD></TR>
	<TR><TD>:node_types_signature</TD><TD PORT="case11">SignatureHeader</TD></TR>
	<TR><TD>:node_types_superblock</TD><TD PORT="case12">SuperblockHeader</TD></TR>
	<TR><TD>:node_types_truncation</TD><TD PORT="case13">TruncationHeader</TD></TR>
</TABLE>>];
		}
		subgraph cluster__branch {
			label="Ubifs::Branch";
			graph[style=dotted];

			branch__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="target_leb_pos">0</TD><TD PORT="target_leb_size">4</TD><TD>u4le</TD><TD PORT="target_leb_type">target_leb</TD></TR>
				<TR><TD PORT="ofs_target_pos">4</TD><TD PORT="ofs_target_size">4</TD><TD>u4le</TD><TD PORT="ofs_target_type">ofs_target</TD></TR>
				<TR><TD PORT="len_target_pos">8</TD><TD PORT="len_target_size">4</TD><TD>u4le</TD><TD PORT="len_target_type">len_target</TD></TR>
				<TR><TD PORT="key_pos">12</TD><TD PORT="key_size">8</TD><TD>Key</TD><TD PORT="key_type">key</TD></TR>
				<TR><TD PORT="hash_pos">20</TD><TD PORT="hash_size">_root.superblock.node_header.len_hash</TD><TD></TD><TD PORT="hash_type">hash</TD></TR>
			</TABLE>>];
			branch__inst__target [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="target_pos">_root.superblock.node_header.leb_size * target_leb + ofs_target</TD><TD PORT="target_size">len_target</TD><TD>Block</TD><TD PORT="target_type">target</TD></TR>
				<TR><TD COLSPAN="4" PORT="target__valid">must satisfy  ((_.header.len_full_node == len_target) &amp;&amp; ((_parent.level != 0 ? _.header.node_type == :node_types_index : (Ubifs::I__NODE_TYPES[_.header.node_type] || _.header.node_type) == (Ubifs::I__KEY_TYPES[key.type] || key.type)))) </TD></TR>
			</TABLE>>];
		}
		subgraph cluster__commit_start_header {
			label="Ubifs::CommitStartHeader";
			graph[style=dotted];

			commit_start_header__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="commit_number_pos">0</TD><TD PORT="commit_number_size">8</TD><TD>u8le</TD><TD PORT="commit_number_type">commit_number</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__common_header {
			label="Ubifs::CommonHeader";
			graph[style=dotted];

			common_header__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="magic_pos">0</TD><TD PORT="magic_size">4</TD><TD>u4le</TD><TD PORT="magic_type">magic</TD></TR>
				<TR><TD COLSPAN="4" PORT="magic__valid">must be equal to 101718065</TD></TR>
				<TR><TD PORT="crc_pos">4</TD><TD PORT="crc_size">4</TD><TD>u4le</TD><TD PORT="crc_type">crc</TD></TR>
				<TR><TD PORT="sequence_number_pos">8</TD><TD PORT="sequence_number_size">8</TD><TD>u8le</TD><TD PORT="sequence_number_type">sequence_number</TD></TR>
				<TR><TD PORT="len_full_node_pos">16</TD><TD PORT="len_full_node_size">4</TD><TD>u4le</TD><TD PORT="len_full_node_type">len_full_node</TD></TR>
				<TR><TD PORT="node_type_pos">20</TD><TD PORT="node_type_size">1</TD><TD>u1→NodeTypes</TD><TD PORT="node_type_type">node_type</TD></TR>
				<TR><TD PORT="group_type_pos">21</TD><TD PORT="group_type_size">1</TD><TD>u1→NodeGroupTypes</TD><TD PORT="group_type_type">group_type</TD></TR>
				<TR><TD PORT="padding_pos">22</TD><TD PORT="padding_size">2</TD><TD>00 00</TD><TD PORT="padding_type">padding</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__data_header {
			label="Ubifs::DataHeader";
			graph[style=dotted];

			data_header__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="key_pos">0</TD><TD PORT="key_size">16</TD><TD>Key</TD><TD PORT="key_type">key</TD></TR>
				<TR><TD PORT="len_uncompressed_pos">16</TD><TD PORT="len_uncompressed_size">4</TD><TD>u4le</TD><TD PORT="len_uncompressed_type">len_uncompressed</TD></TR>
				<TR><TD COLSPAN="4" PORT="len_uncompressed__valid">must be between 1 and 4096</TD></TR>
				<TR><TD PORT="compression_pos">20</TD><TD PORT="compression_size">2</TD><TD>u2le→Compression</TD><TD PORT="compression_type">compression</TD></TR>
				<TR><TD COLSPAN="4" PORT="compression__valid">must be defined in the enum</TD></TR>
				<TR><TD PORT="len_compressed_data_pos">22</TD><TD PORT="len_compressed_data_size">2</TD><TD>u2le</TD><TD PORT="len_compressed_data_type">len_compressed_data</TD></TR>
				<TR><TD PORT="data_pos">24</TD><TD PORT="data_size">⇲</TD><TD></TD><TD PORT="data_type">data</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__directory_header {
			label="Ubifs::DirectoryHeader";
			graph[style=dotted];

			directory_header__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="key_pos">0</TD><TD PORT="key_size">16</TD><TD>Key</TD><TD PORT="key_type">key</TD></TR>
				<TR><TD COLSPAN="4" PORT="key__valid">must satisfy  ((_.type == :key_types_directory) || (_.type == :key_types_extended_attribute)) </TD></TR>
				<TR><TD PORT="inode_number_pos">16</TD><TD PORT="inode_number_size">8</TD><TD>u8le</TD><TD PORT="inode_number_type">inode_number</TD></TR>
				<TR><TD COLSPAN="4" PORT="inode_number__valid">must be at most 4294967295</TD></TR>
				<TR><TD PORT="padding1_pos">24</TD><TD PORT="padding1_size">1</TD><TD>00</TD><TD PORT="padding1_type">padding1</TD></TR>
				<TR><TD PORT="inode_type_pos">25</TD><TD PORT="inode_type_size">1</TD><TD>u1→InodeTypes</TD><TD PORT="inode_type_type">inode_type</TD></TR>
				<TR><TD COLSPAN="4" PORT="inode_type__valid">must be defined in the enum</TD></TR>
				<TR><TD PORT="len_name_pos">26</TD><TD PORT="len_name_size">2</TD><TD>u2le</TD><TD PORT="len_name_type">len_name</TD></TR>
				<TR><TD PORT="cookie_pos">28</TD><TD PORT="cookie_size">4</TD><TD>u4le</TD><TD PORT="cookie_type">cookie</TD></TR>
				<TR><TD PORT="name_pos">32</TD><TD PORT="name_size">len_name</TD><TD></TD><TD PORT="name_type">name</TD></TR>
				<TR><TD PORT="name_terminator_pos">...</TD><TD PORT="name_terminator_size">1</TD><TD>00</TD><TD PORT="name_terminator_type">name_terminator</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__dummy {
			label="Ubifs::Dummy";
			graph[style=dotted];

			dummy__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__index_block {
			label="Ubifs::IndexBlock";
			graph[style=dotted];

			index_block__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="header_pos">0</TD><TD PORT="header_size">24</TD><TD>CommonHeader</TD><TD PORT="header_type">header</TD></TR>
				<TR><TD COLSPAN="4" PORT="header__valid">must satisfy _.node_type == :node_types_index</TD></TR>
				<TR><TD PORT="node_header_pos">24</TD><TD PORT="node_header_size">header.len_full_node - 24</TD><TD>IndexHeader</TD><TD PORT="node_header_type">node_header</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__index_header {
			label="Ubifs::IndexHeader";
			graph[style=dotted];

			index_header__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="num_branches_pos">0</TD><TD PORT="num_branches_size">2</TD><TD>u2le</TD><TD PORT="num_branches_type">num_branches</TD></TR>
				<TR><TD PORT="level_pos">2</TD><TD PORT="level_size">2</TD><TD>u2le</TD><TD PORT="level_type">level</TD></TR>
				<TR><TD PORT="branches_pos">4</TD><TD PORT="branches_size">...</TD><TD>Branch</TD><TD PORT="branches_type">branches</TD></TR>
				<TR><TD COLSPAN="4" PORT="branches__repeat">repeat num_branches times</TD></TR>
			</TABLE>>];
		}
		subgraph cluster__inode_header {
			label="Ubifs::InodeHeader";
			graph[style=dotted];

			inode_header__seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">pos</TD><TD BGCOLOR="#E0FFE0">size</TD><TD BGCOLOR="#E0FFE0">type</TD><TD BGCOLOR="#E0FFE0">id</TD></TR>
				<TR><TD PORT="key_pos">0</TD><TD PORT="key_size">16</TD><TD>Key</TD><TD PORT="key_type">key</TD></TR>
				<TR><TD PORT="creation_sequence_number_pos">16</TD><TD PORT="creation_sequence_number_size">8</TD><TD>u8le</TD><TD PORT="creation_sequence_number_type">creation_sequence_number</TD></TR>
				<TR><TD PORT="len_uncompressed_pos">24</TD><TD PORT="len_uncompressed_size">8</TD><TD>u8le</TD><TD PORT="len_uncompressed_type">len_uncompressed</TD></TR>
				<TR><TD PORT="atime_sec_pos">32</TD><TD PORT="atime_sec_size">8</TD><TD>u8le</TD><TD PORT="atime_sec_type">atime_sec</TD></TR>
				<TR><TD PORT="ctime_sec_pos">40</TD><TD PORT="ctime_sec_size">8</TD><TD>u8le</TD><TD PORT="ctime_sec_type">ctime_sec</TD></TR>
				<TR><TD PORT="mtime_sec_pos">48</TD><TD PORT="mtime_sec_size">8</TD><TD>u8le</TD><TD PORT="mtime_sec_type">mtime_sec</TD></TR>
				<TR><TD PORT="atime_nsec_pos">56</TD><TD PORT="atime_nsec_size">4</TD><TD>u4le</TD><TD PORT="atime_nsec_type">atime_nsec</TD></TR>
				<TR><TD PORT="ctime_nsec_pos">60</TD><TD PORT="ctime_nsec_size">4</TD><TD>u4le</TD><TD PORT="ctime_nsec_type">ctime_nsec</TD></TR>
				<TR><TD PORT="mtime_nsec_pos">64</TD><TD PORT="mtime_nsec_size">4</TD><TD>u4le</TD><TD PORT="mtime_nsec_type">mtime_nsec</TD></TR>
				<TR><TD PORT="num_links_pos">68</TD><TD PORT="num_links_size">4</TD><TD>u4le</TD><TD PORT="num_links_type">num_links</TD></TR>
				<TR><TD PORT="uid_pos">72</TD><TD PORT="uid_size">4</TD><TD>u4le</TD><TD PORT="uid_type">uid</TD></TR>
				<TR><TD PORT="gid_pos">76</TD><TD PORT="gid_size">4</TD><TD>u4le</TD><TD PORT="gid_type">gid</TD></TR>
				<TR><TD PORT="mode_pos">80</TD><TD PORT="mode_size">4</TD><TD>u4le</TD><TD PORT="mode_type">mode</TD></TR>
				<TR><TD PORT="flags_pos">84</TD><TD PORT="flags_size">4</TD><TD>u4le</TD><TD PORT="flags_type">flags</TD></TR>
				<TR><TD PORT="len_data_pos">88</TD><TD PORT="len_data_size">4</TD><TD>u4le</TD><TD PORT="len_data_type">len_data</TD></TR>
				<TR><TD PORT="num_xattrs_pos">92</TD><TD PORT="num_xattrs_size">4</TD><TD>u4le</TD><TD PORT="num_xattrs_type">num_xattrs</TD></TR>
				<TR><TD PORT="xattr_size_pos">96</TD><TD PORT="xattr_size_size">4</TD><TD>u4le</TD><TD PORT="xattr_size_type">xattr_size</TD></TR>
				<TR><TD PORT="padding1_pos">100</TD><TD PORT="padding1_size">4</TD><TD>00 00 00 00</TD><TD PORT="padding1_type">padding1</TD></TR>
				<TR><TD PORT="xattr_names_pos">104</TD><TD PORT="xattr_names_size">4</TD><TD>u4le</TD><TD PORT="xattr_names_type">xattr_names</TD></TR>
				<TR><TD PORT="compression_pos">108</TD><TD PORT="compression_size">2</TD><TD>u2le→Compression</TD><TD PORT="compression_type">compression</TD></TR>
				<TR><TD COLSPAN="4" PORT="compression__valid">must be defined in the enum</TD></TR>
				<TR><TD PORT="padding2_pos">110</TD><TD PORT="padding2_size">26</TD><TD></TD><TD PORT="padding2_type">padding2</TD></TR>
				<TR><TD PORT="data_pos">136</TD><TD PORT="data_size">len_data</TD><TD></TD><TD PORT="data_type">data</TD></TR>
			</TABLE>>];
			inode_header__inst__append [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>append</TD><TD>flags &amp; 8 != 0</TD></TR>
			</TABLE>>];
			inode_header__inst__compressed [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>compressed</TD><TD>flags &amp; 1 != 0</TD></TR>
			</TABLE>>];
			inode_header__inst__dirsync [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>dirsync</TD><TD>flags &amp; 16 != 0</TD></TR>
			</TABLE>>];
			inode_header__inst__encrypted [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>encrypted</TD><TD>flags &amp; 64 != 0</TD></TR>
			</TABLE>>];
			inode_header__inst__immutable [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>immutable</TD><TD>flags &amp; 4 != 0</TD></TR>
			</TABLE>>];
			inode_header__inst__is_block_device [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>is_block_device</TD><TD>mode &amp; 61440 == 24576</TD></TR>
			</TABLE>>];
			inode_header__inst__is_character_device [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
				<TR><TD>is_character_device</TD><TD>mode &amp; 61440 == 8192</TD></TR>
			</TABLE>>];
			inode_header__inst__is_dir [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
				<TR><TD BGCOLOR="#E0FFE0">id</TD><TD BGCOLOR="#E0FFE0">value</TD></TR>
